#SOMA DE DOIS NÚMEROS INTEIROS
def soma(a, b):
    resultado = a + b
    return resultado

#ENTRADA DOS DADOS
a = int(input("Digite o primeiro número: "))
b = int(input("Digite o segundo número: "))

#RESTRIÇÕES
if 1 <= a <= 1000 and 1 <= b <= 1000:
    print("Resultado:", soma(a, b))
else:
    print("Erro: os valores devem estar entre 1 e 1000.")
