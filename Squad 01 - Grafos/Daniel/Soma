def soma(a: int, b: int) -> int:
    """
    Calcula a soma de dois números inteiros.

    Parâmetros:
        a (int): o primeiro valor  → 1 ≤ a ≤ 1000
        b (int): o segundo valor   → 1 ≤ b ≤ 1000

    Retorno:
        int: a soma de a e b
    """
    resultado = 0
    resultado = a + b
    return resultado


# --- Testes ---
if __name__ == "__main__":
    # Exemplo do enunciado
    print(soma(7, 3))   # Esperado: 10

    # Exemplo de entrada/saída
    print(soma(2, 3))   # Esperado: 5

    # Casos extremos
    print(soma(1, 1))      # Esperado: 2
    print(soma(1000, 1000)) # Esperado: 2000
