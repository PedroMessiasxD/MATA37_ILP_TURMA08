def organizingContainers(container):
    n = len(container)
    
    # Calcular a soma de cada container (capacidade)
    container_sums = []
    for i in range(n):
        total = 0
        for j in range(n):
            total += container[i][j]
        container_sums.append(total)
    
    # Calcular a soma de cada tipo de bola (total por coluna)
    type_sums = []
    for j in range(n):
        total = 0
        for i in range(n):
            total += container[i][j]
        type_sums.append(total)
    
    # Ordenar ambas as listas
    # Implementação manual de ordenação (bubble sort)
    for i in range(len(container_sums)):
        for j in range(0, len(container_sums) - i - 1):
            if container_sums[j] > container_sums[j + 1]:
                container_sums[j], container_sums[j + 1] = container_sums[j + 1], container_sums[j]
    
    for i in range(len(type_sums)):
        for j in range(0, len(type_sums) - i - 1):
            if type_sums[j] > type_sums[j + 1]:
                type_sums[j], type_sums[j + 1] = type_sums[j + 1], type_sums[j]
    
    # Comparar as listas ordenadas
    for i in range(n):
        if container_sums[i] != type_sums[i]:
            return "Impossible"
    
    return "Possible"