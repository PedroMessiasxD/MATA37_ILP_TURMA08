import sys

def next_permutation(w: str) -> str:
    chars = list(w)
    n = len(chars)
    
    i = n - 2
    while i >= 0 and chars[i] >= chars[i + 1]:
        i -= 1
        
    if i == -1:
        return "no answer"
        
    j = n - 1
    while chars[j] <= chars[i]:
        j -= 1
        
    chars[i], chars[j] = chars[j], chars[i]
    
    chars[i + 1:] = reversed(chars[i + 1:])
    
    return "".join(chars)

is_terminal = sys.stdin.isatty()

prompt_t = "Digite o número de casos de teste: " if is_terminal else ""
entrada = input(prompt_t).strip()

try:
    t = int(entrada)
    palavras = []
    
    # 1. Recebe todas as entradas de uma vez
    for i in range(t):
        prompt_w = f"Digite a palavra {i+1} de {t}: " if is_terminal else ""
        palavras.append(input(prompt_w).strip())
        
    # 2. Mostra todos os resultados juntos no final
    if is_terminal:
        print("\n--- Resultados ---")
        
    for i, palavra in enumerate(palavras):
        prefix = f"Resultado {i+1}: " if is_terminal else ""
        print(f"{prefix}{next_permutation(palavra)}")
        
except ValueError:
    prefix = "Resultado: " if is_terminal else ""
    print(f"{prefix}{next_permutation(entrada)}")
